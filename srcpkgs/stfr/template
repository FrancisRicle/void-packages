# Template file for 'st'
pkgname=stfr
version=1.1
revision=1
build_style=gnu-makefile
make_use_env=compliant
hostmakedepends="pkg-config"
makedepends="fontconfig-devel libX11-devel libXft-devel harfbuzz freetype"
depends=""
short_desc="Suckless terminal implementation for X Francis Ricle fork's"
maintainer="FrancisRicle <francisricleruiz@gmail.com>"
license="MIT"
homepage="https://st.suckless.org"
distfiles="https://github.com/FrancisRicle/st/archive/refs/tags/st-${version}.tar.gz"
checksum=fda30933ff95d562e74aceab2b1bdbb9164d6eeee7da72b4fe2b02d266d6fa14
pre_build() {
	mkdir -p ${DESTDIR}/usr/share/terminfo
}

pre_install() {
	export TERMINFO=${DESTDIR}/usr/share/terminfo
}

post_install() {
	vdoc README
	vdoc FAQ
	vlicense LICENSE
}
